{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "CV": {
      "title": "CV",
      "description": "Curriculum Vitae data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string", "description": "Name of the CV version" },
        "data": { "type": "object", "description": "Full CV JSON data" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "data", "createdAt"]
    },
    "Document": {
      "title": "Document",
      "description": "Generated professional documents",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "content", "createdAt"]
    },
    "Interview": {
      "title": "Interview",
      "description": "Interview simulation session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "position": { "type": "string" },
        "area": { "type": "string" },
        "level": { "type": "string" },
        "modality": { "type": "string" },
        "questionsCount": { "type": "number" },
        "status": { "type": "string" },
        "totalScore": { "type": "number" },
        "duration": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" },
        "questions": { "type": "array" }
      },
      "required": ["userId", "position", "questions", "completedAt"]
    },
    "CVAnalysis": {
      "title": "CV Analysis",
      "description": "AI-powered CV analysis and feedback",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fileName": { "type": "string" },
        "overallScore": { "type": "number" },
        "atsCompatible": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "overallScore", "createdAt"]
    },
    "BlogComment": {
      "title": "Blog Comment",
      "description": "Public comments on the blog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "text", "createdAt"]
    },
    "NewsletterSub": {
      "title": "Newsletter Subscription",
      "description": "Emails for news updates",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/cvs/{cvId}": {
      "schema": "CV",
      "description": "User CVs"
    },
    "/documents/{docId}": {
      "schema": "Document",
      "description": "Generated documents"
    },
    "/interviews/{interviewId}": {
      "schema": "Interview",
      "description": "Interview history"
    },
    "/blog_comments/{commentId}": {
      "schema": "BlogComment",
      "description": "Public blog comments"
    },
    "/newsletter_subs/{subId}": {
      "schema": "NewsletterSub",
      "description": "Newsletter subscriptions"
    },
    "/cv_analyses/{analysisId}": {
      "schema": "CVAnalysis",
      "description": "CV analysis reports"
    }
  }
}
