rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) 
        && incoming().uid == userId
        && incoming().email is string
        && incoming().email.size() <= 100
        && incoming().keys().hasAll(['uid', 'email', 'createdAt'])
        && incoming().keys().size() >= 3;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'area', 'skills', 'updatedAt', 'stats',
          'cargo', 'ciudad', 'pais', 'linkedin', 'github', 'portfolio'
        ]);
    }

    // CVs
    match /cvs/{cvId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().data is map
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Documents
    match /documents/{docId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().content is string
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Interviews
    match /interviews/{interviewId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().questions is list
        && incoming().completedAt == request.time;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // CV Analyses
    match /cv_analyses/{analysisId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Blog Comments (Public Create & Read)
    match /blog_comments/{commentId} {
      allow read, list: if true;
      allow create: if incoming().name is string 
        && incoming().name.size() <= 100
        && incoming().text is string
        && incoming().text.size() <= 1000
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Newsletter Subscriptions (Public Create)
    match /newsletter_subs/{subId} {
      allow read, list: if false; // Only via console/admin
      allow create: if incoming().email is string 
        && incoming().email.matches('^[^@]+@[^@]+\\.[^@]+$')
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
